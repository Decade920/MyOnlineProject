# 敏感文件
*.tfvars

!envs/dev/terraform.tfvars
!envs/prod/terraform.tfvars

# Terraform 状态文件
*.tfstate
*.tfstate.backup

# Terraform 插件目录
.terraform/

# 保留 lock 文件（应该提交）
!.terraform.lock.hcl

# 忽略备份文件
*.bakup

# 忽略ansible inventory目录、group_vars、host_vars目录
inventory/hosts
group_vars/all/vaults.yml
host_vars/*/vaults.yml
ansible/*.retry
.ansible/
ansible/*.log